# ---------------------------------------------------------------------------
# Amazon Ads Search Term report -> powerbidb.`search term report`
#
#   cp .env.example .env && chmod 600 .env
#
# .env holds secrets: never commit it. Exported environment variables take
# precedence over values in this file.
# ---------------------------------------------------------------------------

# --- MySQL --------------------------------------------------------------------
DB_HOST=db.example.internal
DB_PORT=3306
DB_NAME=powerbidb
DB_USER=search_term_loader
DB_PASSWORD=change-me
# The table name contains spaces; write it without quotes or backticks.
REPORT_TABLE=search term report
DB_CONNECT_TIMEOUT_SECONDS=30
# Only used when the table's `Date` column is a text (VARCHAR/CHAR) column:
# the format existing rows use. The run checks a sample and stops on mismatch.
DB_TEXT_DATE_FORMAT=%Y-%m-%d
# Only matters for a TIMESTAMP `Date` column: MySQL session time_zone, e.g. +05:30.
# DB_SESSION_TIME_ZONE=
# DB_SSL_CA=/etc/ssl/certs/mysql-ca.pem
DB_SSL_DISABLED=false
# Attempts for the date-scoped import transaction (only re-tried after a rollback).
DB_MAX_ATTEMPTS=2

# --- Report selection ---------------------------------------------------------
# Business rule: before 12:30 in REPORT_TIMEZONE -> yesterday; from 12:30 -> today.
REPORT_TIMEZONE=Asia/Kolkata
TODAY_REPORT_CUTOFF=12:30
# The advertiser account's (marketplace) timezone: the calendar of the CSV's Date
# column. The live history page shows times like "2:00 AM PDT" for a US account,
# i.e. America/Los_Angeles. Use Asia/Kolkata for an India account.
AMAZON_ACCOUNT_TIMEZONE=America/Los_Angeles
# The calendar Amazon uses for a saved report's "Today"/"Yesterday": the Amazon
# USER's timezone, not the account's (observed live 2026-10-23: IST). Defaults to
# REPORT_TIMEZONE.
# REPORT_PERIOD_TIMEZONE=Asia/Kolkata

# Two SAVED Search Term reports in Amazon Ads (Reporting > Sponsored ads
# reports): Report type = Search term, Time unit = Daily, File format = CSV,
# Report period = "Today" and "Yesterday". Copy the reportId=... value from
# each report's history URL.
REPORT_ID_TODAY=00000000-0000-0000-0000-000000000000
REPORT_ID_YESTERDAY=00000000-0000-0000-0000-000000000000
# Optional: text the report page must show (e.g. the report name) to catch a
# swapped ID before anything runs.
# REPORT_NAME_TODAY=Search term - Today
# REPORT_NAME_YESTERDAY=Search term - Yesterday
# The entityId=... value from the report URL (the advertiser account).
AMAZON_ENTITY_ID=ENTITYXXXXXXXXXXXXX
# REPORT_HISTORY_URL_TEMPLATE=https://advertising.amazon.com/reporting/history?entityId={entity_id}&reportId={report_id}

# --- Amazon sign-in (server without a screen) ---------------------------------
# Used ONLY by 'run.py --login' when there is no display: a hidden browser fills
# these in and you type the two-step code in the terminal. Scheduled runs never
# sign in. Leave empty on a desktop (the visible browser is used instead).
AMAZON_EMAIL=
AMAZON_PASSWORD=

# --- Browser ------------------------------------------------------------------
HEADLESS=true
# Keep the same browser identity for --login and scheduled runs; a different
# (headless) user agent can make Amazon ask for two-step verification again.
# Example for Linux + Chromium 140:
# BROWSER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36
BROWSER_TIMEOUT_MS=60000
DOWNLOAD_TIMEOUT_MS=180000
REPORT_POLL_INTERVAL_SECONDS=30
# Keep this well under one hour so hourly runs never pile up.
REPORT_READY_TIMEOUT_SECONDS=1200
# Allowed difference between this server's clock and Amazon's "Date created".
RUN_CLOCK_SKEW_SECONDS=120
LOGIN_TIMEOUT_SECONDS=900
BROWSER_RETRIES=1
# Only if Chromium cannot start inside a container.
BROWSER_NO_SANDBOX=false

# --- CSV ----------------------------------------------------------------------
# Leave unset to auto-detect (Oct 21, 2026 / 2026-10-21 / 10/21/2026 ...).
# CSV_DATE_FORMAT=%b %d, %Y
# A header-only report would replace the date's rows with nothing; refused unless true.
ALLOW_EMPTY_REPORT=false
# warn = log duplicate rows and keep them; fail = reject the file.
DUPLICATE_POLICY=warn

# --- Paths and logging ----------------------------------------------------------
DOWNLOAD_DIR=data/downloads
PROCESSED_DIR=data/processed
FAILED_DIR=data/failed
SCREENSHOT_DIR=data/screenshots
# Chromium profile holding the Amazon session: treat it as a credential.
SESSION_DIR=data/session
STATE_DIR=data/state
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=10

# --- Run mode -------------------------------------------------------------------
# both: every run imports the Yesterday report, then the Today report.
# cutoff: one report per run, chosen by TODAY_REPORT_CUTOFF.
# REPORT_MODE=cutoff
